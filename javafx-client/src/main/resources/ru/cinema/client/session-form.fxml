<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<GridPane xmlns:fx="http://javafx.com/fxml" fx:controller="ru.cinema.client.ui.SessionFormController" hgap="10" vgap="10" styleClass="form" stylesheets="@style.css">
  <Label text="Фильм" GridPane.rowIndex="0" GridPane.columnIndex="0"/><ComboBox fx:id="movie" prefWidth="260" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
  <Label text="Зал" GridPane.rowIndex="1" GridPane.columnIndex="0"/><ComboBox fx:id="hall" prefWidth="260" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
  <Label text="Начало" GridPane.rowIndex="2" GridPane.columnIndex="0"/><TextField fx:id="start" promptText="2026-11-01T18:30" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
  <Label text="Цена" GridPane.rowIndex="3" GridPane.columnIndex="0"/><TextField fx:id="price" promptText="Например, 500" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
</GridPane>

